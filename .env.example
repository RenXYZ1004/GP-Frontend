# ════════════════════════════════════════════════════════════════
# Vercel environment — frontend only
# ════════════════════════════════════════════════════════════════
# The API, the database and the parent-email functions live in the
# GP-Backend project now; their secrets are Firebase secrets, not these.
# See GP-Backend/functions/.env.example.
#
# What is left here is what still runs on Vercel: the photo upload, and
# the one-time Gmail OAuth helper used to mint a refresh token.
# ════════════════════════════════════════════════════════════════

# ── Student photo storage (api/upload-photo.js) ─────────────────
# Vercel dashboard → Storage → your Blob store → connect it to this project
# and Vercel sets this for you. The @vercel/blob SDK reads it by name.
BLOB_READ_WRITE_TOKEN=

# ── Caller check (api/_lib/request-guard.js) ────────────────────
# Both optional. The guard already trusts the deployment's own Host, so
# these only matter if the site is reached on another domain.
# ALLOWED_ORIGINS=https://gp-frontend-alpha.vercel.app
# APP_BASE_URL=https://gp-frontend-alpha.vercel.app
# Set to 1 to also reject requests carrying no Origin/Referer at all.
# STRICT_ORIGIN=1

# ── Gmail OAuth helper (api/oauth-start.js, api/oauth-callback.js) ──
# These two endpoints exist only to mint a Gmail refresh token when the old
# one expires. The token they produce is then stored as a Firebase secret
# (GMAIL_REFRESH_TOKEN) — the backend is what actually sends the mail.
#
# The redirect URI is registered against this Vercel domain in the Google
# Cloud console, which is why the flow stays here rather than moving to
# Cloud Functions.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gp-frontend-alpha.vercel.app/api/oauth-callback
